Code Examples
JavaScript/Node.js Example
javascript// Search by phone
const searchByPhone = async (phone) => {
  const response = await fetch('https://your-domain.com/api/tracers/search/phone', {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${token}`,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      phone: phone,
      skipCache: false
    })
  });
  
  return await response.json();
};

// Enrich a lead
const enrichLead = async (leadId) => {
  const response = await fetch(`https://your-domain.com/api/tracers/enrich-lead/${leadId}`, {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${token}`,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      forceRefresh: false
    })
  });
  
  return await response.json();
};

// Usage
const phoneData = await searchByPhone('5303061234');
console.log('Found person:', phoneData.data.results[0].FirstName);

const enrichment = await enrichLead(123);
console.log('Enrichment confidence:', enrichment.enrichment.confidence);
React Component Example
jsximport React, { useState } from 'react';
import axios from 'axios';

const LeadEnrichment = ({ leadId, token }) => {
  const [loading, setLoading] = useState(false);
  const [enrichmentData, setEnrichmentData] = useState(null);
  
  const enrichLead = async () => {
    setLoading(true);
    try {
      const response = await axios.post(
        `/api/tracers/enrich-lead/${leadId}`,
        { forceRefresh: false },
        {
          headers: {
            'Authorization': `Bearer ${token}`
          }
        }
      );
      
      setEnrichmentData(response.data.enrichment);
    } catch (error) {
      console.error('Enrichment failed:', error);
    } finally {
      setLoading(false);
    }
  };
  
  return (
    <div>
      <button onClick={enrichLead} disabled={loading}>
        {loading ? 'Enriching...' : 'Enrich Lead'}
      </button>
      
      {enrichmentData && (
        <div>
          <h3>Enrichment Results</h3>
          <p>Confidence: {(enrichmentData.confidence * 100).toFixed(0)}%</p>
          <p>Age: {enrichmentData.enrichmentData.age}</p>
          <p>Emails: {enrichmentData.enrichmentData.emails.length}</p>
          <p>Addresses: {enrichmentData.enrichmentData.addresses.length}</p>
        </div>
      )}
    </div>
  );
};
