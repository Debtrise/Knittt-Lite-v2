4. Add Call-Specific Status/Monitoring Views
Create new UI components for monitoring call webhooks:
javascript// Call webhook status component
const CallWebhookStatus = ({ webhookId }) => {
  const [status, setStatus] = useState(null);
  
  useEffect(() => {
    fetchCallStatus();
  }, [webhookId]);
  
  const fetchCallStatus = async () => {
    const response = await api.get(`/api/webhooks/${webhookId}/call-status`);
    setStatus(response.data);
  };
  
  return (
    <StatusCard>
      <h3>Call Performance</h3>
      <MetricGrid>
        <Metric label="Total Events" value={status?.stats.totalEvents} />
        <Metric label="Successful" value={status?.stats.successfulEvents} />
        <Metric label="Failed" value={status?.stats.failedEvents} />
        <Metric label="Calls Initiated" value={status?.stats.totalCallsInitiated} />
        <Metric label="Avg Attempts/Lead" value={status?.stats.averageAttemptsPerLead.toFixed(1)} />
      </MetricGrid>
      
      <RecentEvents>
        <h4>Recent Call Events</h4>
        {status?.recentEvents.map(event => (
          <EventRow key={event.id}>
            <Status type={event.status} />
            <Time>{formatDate(event.receivedAt)}</Time>
            <Info>
              {event.callsInitiated} calls, {event.attempts} attempts
              {event.errors.length > 0 && (
                <Errors>{event.errors.join(', ')}</Errors>
              )}
            </Info>
          </EventRow>
        ))}
      </RecentEvents>
    </StatusCard>
  );
};
