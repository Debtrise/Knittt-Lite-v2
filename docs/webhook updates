7. Form Validation Updates
Add validation for call-specific fields:
javascriptconst validateCallWebhook = (formData) => {
  const errors = {};
  
  if (formData.webhookType === 'call') {
    if (!formData.callConfig?.dialerContext) {
      errors['callConfig.dialerContext'] = 'Dialer context is required';
    }
    
    if (!formData.callConfig?.transferNumber) {
      errors['callConfig.transferNumber'] = 'Transfer number is required';
    } else if (!/^\d{10,}$/.test(formData.callConfig.transferNumber.replace(/\D/g, ''))) {
      errors['callConfig.transferNumber'] = 'Invalid phone number format';
    }
    
    if (formData.callConfig?.delayBetweenCalls < 60) {
      errors['callConfig.delayBetweenCalls'] = 'Minimum delay is 60 seconds';
    }
  }
  
  return errors;
};
