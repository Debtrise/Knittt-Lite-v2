## 2. Widget Types and Configurations

### 2.1 Metric Widget
Displays a single metric value with optional comparison.

```json
{
  "type": "metric",
  "title": "Total Revenue",
  "position": { "x": 0, "y": 0, "w": 3, "h": 2 },
  
  "config": {
    // Display Settings
    "format": "currency",        // "number", "currency", "percent", "decimal"
    "decimals": 2,              // Number of decimal places
    "prefix": "$",              // Text before value
    "suffix": "",               // Text after value
    "locale": "en-US",          // Locale for formatting
    
    // Comparison Settings
    "comparison": {
      "enabled": true,
      "type": "previous_period",  // "previous_period", "target", "custom"
      "showPercentage": true,
      "showAbsolute": false,
      "invertColors": false       // Red for increase, green for decrease
    },
    
    // Visual Settings
    "icon": "dollar-sign",       // Lucide icon name
    "iconPosition": "left",      // "left", "right", "top"
    "size": "large",            // "small", "medium", "large", "xl"
    "align": "center",          // "left", "center", "right"
    
    // Conditional Formatting
    "conditionalFormatting": [
      {
        "condition": "value > 100000",
        "color": "#10B981",      // Green
        "backgroundColor": "#D1FAE5"
      },
      {
        "condition": "value < 50000",
        "color": "#EF4444",      // Red
        "backgroundColor": "#FEE2E2"
      }
    ],
    
    // Sparkline
    "sparkline": {
      "enabled": true,
      "type": "line",           // "line", "bar"
      "height": 40,
      "color": "#3B82F6"
    }
  },
  
  "dataSource": {
    "sourceId": "ds1",
    "aggregation": "sum",       // "sum", "avg", "count", "min", "max"
    "field": "revenue",
    "filters": {
      "status": {
        "operator": "eq",
        "value": "completed"
      }
    }
  }
}
```

