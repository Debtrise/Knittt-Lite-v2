    },
    
    // Headers
    "headers": {
      "Content-Type": "application/json",
      "X-Tenant-ID": "{context.tenantId}"
    },
    
    // Request Body
    "body": {
      "startDate": "{filter.startDate}",
      "endDate": "{filter.endDate}",
      "metrics": ["revenue", "leads", "conversions"],
      "groupBy": "day"
    },
    
    // Response Mapping
    "responseMapping": {
      "data": "$.data.metrics",   // JSONPath to data array
      "total": "$.data.total",
      "fields": {
        "date": "$.timestamp",
        "revenue": "$.values.revenue",
        "leads": "$.values.lead_count"
      }
    },
    
    // Error Handling
    "retry": {
      "attempts": 3,
      "delay": 1000,
      "backoff": "exponential"
    },
    
    // Caching
    "cache": {
      "enabled": true,
      "ttl": 300,                // 5 minutes
      "key": "api_{endpoint}_{params}"
    }
  }
}
```

