## 1. Report Builder Configuration

The main report configuration when creating a custom report.

```json
{
  "name": "Sales Performance Dashboard",
  "description": "Monthly sales metrics and KPIs",
  
  // Layout Configuration
  "layout": {
    "type": "grid",           // Options: "grid", "freeform"
    "columns": 12,            // Number of grid columns (typically 12 or 24)
    "rows": "auto",           // "auto" or fixed number
    "gap": 16,                // Gap between widgets in pixels
    "responsive": true,       // Enable responsive behavior
    "breakpoints": {          // Optional: Custom breakpoints
      "mobile": 768,
      "tablet": 1024,
      "desktop": 1440
    }
  },
  
  // Theme Configuration
  "theme": {
    "mode": "light",                    // "light" or "dark"
    "primaryColor": "#3B82F6",          // Primary brand color
    "backgroundColor": "#FFFFFF",        // Background color
    "textColor": "#1F2937",             // Default text color
    "borderRadius": 8,                  // Default border radius
    "shadow": "sm",                     // Shadow size: "none", "sm", "md", "lg", "xl"
    "fontFamily": "Inter, sans-serif",  // Optional: Custom font
    "fontSize": {                       // Optional: Font size scale
      "xs": 12,
      "sm": 14,
      "base": 16,
      "lg": 18,
      "xl": 20
    }
  },
  
  // Data Sources (see section 3 for details)
  "dataSources": [...],
  
  // Refresh Settings
  "refreshInterval": 300,     // Auto-refresh in seconds (0 = disabled)
  "cacheTimeout": 3600,       // Cache duration in seconds
  
  // Access Control
  "isPublic": false,          // Make report publicly accessible
  "publicToken": "...",       // Auto-generated if public
  "permissions": {
    "view": ["user_id_1", "user_id_2"],     // User IDs who can view
    "edit": ["user_id_1"],                   // User IDs who can edit
    "delete": ["user_id_1"],                 // User IDs who can delete
    "share": ["user_id_1"],                  // User IDs who can share
    "export": ["*"]                          // "*" means all viewers
  },
  
  // Metadata
  "tags": ["sales", "monthly", "kpi"],       // Searchable tags
  "category": "sales",                       // Report category
  "version": 1,                              // Version number
  "isTemplate": false,                       // Save as reusable template
  
  // Advanced Settings
  "filters": {                               // Global filters
    "dateRange": {
      "enabled": true,
      "default": "last_30_days",
      "options": ["today", "yesterday", "last_7_days", "last_30_days", "custom"]
    },
    "sources": {
      "enabled": true,
      "multiple": true,
      "default": ["all"]
    }
  },
  
  // Export Settings
  "exportFormats": ["pdf", "excel", "csv"],  // Allowed export formats
  "printLayout": {                           // Print-specific settings
    "orientation": "landscape",              // "portrait" or "landscape"
    "pageSize": "A4",                       // "A4", "Letter", etc.
    "margins": {
      "top": 20,
      "right": 20,
      "bottom": 20,
      "left": 20
    }
  }
}
```

