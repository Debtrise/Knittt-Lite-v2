## 3. Data Source Configurations

### 3.1 Table Data Source
Direct database table access.

```json
{
  "id": "leads_source",
  "type": "table",
  "name": "Leads Data",
  
  "config": {
    "table": "Leads",            // Table name
    "schema": "public",          // Optional: Database schema
    
    // Available Fields
    "fields": [
      "id",
      "firstName",
      "lastName",
      "email",
      "phone",
      "source",
      "status",
      "revenue",
      "createdAt",
      "updatedAt"
    ],
    
    // Joins Configuration
    "joins": [
      {
        "type": "LEFT",          // "INNER", "LEFT", "RIGHT"
        "table": "CallLogs",
        "alias": "calls",
        "on": "Leads.id = calls.leadId",
        "fields": ["duration", "status as callStatus"]
      },
      {
        "type": "LEFT",
        "table": "LeadTags",
        "alias": "tags",
        "on": "Leads.id = tags.leadId",
        "fields": ["tagName"]
      }
    ],
    
    // Default Filters
    "filters": {
      "isActive": {
        "operator": "eq",
        "value": true
      },
      "tenantId": {
        "operator": "eq",
        "value": "{context.tenantId}"  // Variable substitution
      }
    },
    
    // Calculated Fields
    "calculatedFields": [
      {
        "name": "fullName",
        "expression": "CONCAT(firstName, ' ', lastName)"
      },
      {
        "name": "daysOpen",
        "expression": "DATEDIFF(NOW(), createdAt)"
      },
      {
        "name": "revenueCategory",
        "expression": "CASE WHEN revenue > 10000 THEN 'High' WHEN revenue > 5000 THEN 'Medium' ELSE 'Low' END"
      }
    ],
    
    // Security
    "permissions": {
      "rowLevel": {
        "enabled": true,
        "field": "assignedTo",
        "value": "{context.userId}"
      },
      "columnLevel": {
        "hidden": ["ssn", "internalNotes"],
        "masked": ["phone", "email"]  // Show partially masked
      }
    }
  }
}
```

### 3.2 Query Data Source
Custom SQL queries.

```json
{
  "id": "custom_metrics",
  "type": "query",
  "name": "Custom Metrics Query",
  
  "config": {
    "sql": `
      SELECT 
        DATE_TRUNC('day', created_at) as date,
        source,
        COUNT(*) as lead_count,
        COUNT(CASE WHEN status = 'converted' THEN 1 END) as conversions,
        AVG(revenue) as avg_revenue,
        SUM(revenue) as total_revenue
      FROM leads
      WHERE 
        tenant_id = :tenantId
        AND created_at BETWEEN :startDate AND :endDate
        {{#if sources}}
          AND source IN (:sources)
        {{/if}}
      GROUP BY DATE_TRUNC('day', created_at), source
      ORDER BY date DESC
    `,
    
    // Parameter Definitions
    "parameters": [
      {
        "name": "tenantId",
        "type": "string",
        "required": true,
        "default": "{context.tenantId}"
      },
      {
        "name": "startDate",
        "type": "date",
        "required": true,
        "default": "{filter.startDate}"
      },
      {
        "name": "endDate",
        "type": "date",
        "required": true,
        "default": "{filter.endDate}"
      },
      {
        "name": "sources",
        "type": "array",
        "required": false,
        "default": "{filter.sources}"
      }
    ],
    
    // Query Validation
    "validation": {
      "maxExecutionTime": 30000,  // 30 seconds
      "maxRows": 10000,
      "allowedStatements": ["SELECT"],
      "forbiddenKeywords": ["DROP", "DELETE", "UPDATE", "INSERT"]
    }
  }
}
```

