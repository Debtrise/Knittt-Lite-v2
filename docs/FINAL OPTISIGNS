## SDKs & Examples

### JavaScript/Node.js Example

```javascript
const axios = require('axios');

class KnitttOptiSigns {
  constructor(apiToken, baseUrl = 'https://app.knittt.com/api') {
    this.apiToken = apiToken;
    this.baseUrl = baseUrl;
  }

  async request(method, endpoint, data = null) {
    const config = {
      method,
      url: `${this.baseUrl}${endpoint}`,
      headers: {
        'Authorization': `Bearer ${this.apiToken}`,
        'Content-Type': 'application/json'
      }
    };

    if (data) {
      config.data = data;
    }

    try {
      const response = await axios(config);
      return response.data;
    } catch (error) {
      throw new Error(error.response?.data?.error || error.message);
    }
  }

  // Configuration
  async testConnection(optisignsToken) {
    return this.request('POST', '/optisigns/config/test', {
      apiToken: optisignsToken
    });
  }

  async getConfig() {
    return this.request('GET', '/optisigns/config');
  }

  async updateConfig(optisignsToken, settings = {}) {
    return this.request('PUT', '/optisigns/config', {
      apiToken: optisignsToken,
      settings
    });
  }

  // Displays
  async syncDisplays() {
    return this.request('POST', '/optisigns/displays/sync');
  }

  async getDisplays(params = {}) {
    const query = new URLSearchParams(params).toString();
    return this.request('GET', `/optisigns/displays?${query}`);
  }

  async pairDevice(pairingCode) {
    return this.request('POST', '/optisigns/devices/pair', {
      pairingCode
    });
  }

  async assignContent(deviceId, contentType, contentId) {
    return this.request('POST', `/optisigns/devices/${deviceId}/assign`, {
      contentType,
      contentId
    });
  }

  // Assets
  async syncAssets() {
    return this.request('POST', '/optisigns/assets/sync');
  }

  async getAssets(params = {}) {
    const query = new URLSearchParams(params).toString();
    return this.request('GET', `/optisigns/assets?${query}`);
  }

  // Playlists
  async createPlaylist(name, description = '') {
    return this.request('POST', '/optisigns/playlists', {
      name,
      description
    });
  }

  async addAssetsToPlaylist(playlistId, assetIds) {
    return this.request('POST', `/optisigns/playlists/${playlistId}/assets`, {
      assetIds
    });
  }

  // Scheduling
  async scheduleContent(deviceId, playlistId, startTime, endTime) {
    return this.request('POST', '/optisigns/schedule', {
      deviceId,
      playlistId,
      startTime,
      endTime
    });
  }

  // Device Takeover
  async takeoverDevice(deviceId, contentType, contentId, options = {}) {
    return this.request('POST', `/optisigns/devices/${deviceId}/takeover`, {
      contentType,
      contentId,
      ...options
    });
  }

  async bulkTakeover(deviceIds, contentType, contentId, options = {}) {
    return this.request('POST', '/optisigns/devices/bulk-takeover', {
      deviceIds,
      contentType,
      contentId,
      ...options
    });
  }

  async emergencyBroadcast(contentType, contentId, options = {}) {
    return this.request('POST', '/optisigns/emergency-broadcast', {
      contentType,
      contentId,
      priority: 'EMERGENCY',
      ...options
    });
  }

  async stopTakeover(deviceId, restoreContent = true) {
    return this.request('POST', `/optisigns/devices/${deviceId}/stop-takeover`, {
      restoreContent
    });
  }

  async getTakeoverStatus(deviceId) {
    return this.request('GET', `/optisigns/devices/${deviceId}/takeover-status`);
  }

  async getActiveTakeovers(params = {}) {
    const query = new URLSearchParams(params).toString();
    return this.request('GET', `/optisigns/takeovers?${query}`);
  }

  async cancelTakeover(takeoverId, reason = '') {
    return this.request('DELETE', `/optisigns/takeovers/${takeoverId}`, {
      reason,
      restoreContent: true
    });
  }

  // Analytics
  async getAnalytics() {
    return this.request('GET', '/optisigns/analytics');
  }
}

// Usage Example
const client = new KnitttOptiSigns('your_jwt_token');

async function example() {
  try {
    // Test OptiSigns connection
    await client.testConnection('your_optisigns_token');
    
    // Configure OptiSigns
    await client.updateConfig('your_optisigns_token', {
      autoSync: true,
      syncInterval: 3600
    });
    
    // Sync displays
    const syncResult = await client.syncDisplays();
    console.log(`Synced ${syncResult.summary.totalSynced} displays`);
    
    // Get displays
    const displays = await client.getDisplays({ isOnline: true });
    console.log(`Found ${displays.displays.length} online displays`);
    
    // Pair new device
    const newDevice = await client.pairDevice('ABC123');
    console.log(`Paired device: ${newDevice.device.name}`);
    
    // Emergency takeover example
    const emergencyAssetId = 'emergency-asset-uuid';
    const takeover = await client.takeoverDevice(
      displays.displays[0].id,
      'ASSET',
      emergencyAssetId,
      {
        priority: 'EMERGENCY',
        duration: 300,
        message: 'Fire alarm - evacuate building',
        restoreAfter: true
      }
    );
    console.log(`Emergency takeover initiated: ${takeover.takeover.id}`);
    
    // Bulk emergency broadcast
    const broadcast = await client.emergencyBroadcast(
      'ASSET',
      emergencyAssetId,
      {
        duration: 600,
        message: 'Building evacuation - all personnel exit immediately',
        criteria: {
          excludeOffline: true,
          includeTags: ['emergency-capable']
        }
      }
    );
    console.log(`Emergency broadcast to ${broadcast.summary.successfulTakeovers} devices`);
    
    // Check takeover status
    const status = await client.getTakeoverStatus(displays.displays[0].id);
    if (status.takeover.isActive) {
      console.log(`Device under takeover: ${status.takeover.message}`);
      console.log(`Time remaining: ${status.takeover.timeRemaining} seconds`);
    }
    
    // Get all active takeovers
    const activeTakeovers = await client.getActiveTakeovers({
      priority: 'EMERGENCY'
    });
    console.log(`Active emergency takeovers: ${activeTakeovers.takeovers.length}`);
    
    // Stop takeover when emergency is resolved
    setTimeout(async () => {
      await client.stopTakeover(displays.displays[0].id, true);
      console.log('Emergency resolved - takeover stopped');
    }, 300000); // Stop after 5 minutes
    
    // Get analytics including takeover data
    const analytics = await client.getAnalytics();
    console.log(`System health: ${analytics.health.status}`);
    console.log(`Active takeovers: ${analytics.summary.activeTakeovers}`);
    
  } catch (error) {
    console.error('Error:', error.message);
  }
}
```

