if [ "$test_status" = "400" ]; then
    print_success "API connection test properly handled invalid token"
else
    print_warning "API connection test status: $test_status (expected 400 for dummy token)"
fi

# Step 4: Test display sync (should fail gracefully without real API key)
print_status "Step 4: Testing display sync..."
sync_result=$(make_api_call "POST" "/api/optisigns/displays/sync" "" "$JWT_TOKEN")
sync_status=$(echo "$sync_result" | cut -d'|' -f1)

