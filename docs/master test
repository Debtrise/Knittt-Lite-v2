
#!/bin/bash

# OptiSigns Configuration Setup Script
# Adds your API token to the system

# Configuration
API_BASE_URL="http://localhost:3001"  # Replace with your actual server URL
USERNAME="admin"                       # Replace with your username
PASSWORD="admin123"                    # Replace with your password

# Your OptiSigns API Token

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

extract_token() {
    local response="$1"
    echo "$response" | grep -o '"token":"[^"]*"' | cut -d'"' -f4
}

echo "=============================================================="
echo "🔧 OptiSigns Configuration Setup"
echo "🎯 Adding your API token to the system"
echo "=============================================================="

# Step 1: Login to get JWT token
print_status "Step 1: Authenticating to dialer app..."

login_response=$(curl -s -X POST \
    "$API_BASE_URL/api/login" \
    -H "Content-Type: application/json" \
    -d "{\"username\":\"$USERNAME\",\"password\":\"$PASSWORD\"}" \
    -w "\nHTTP_STATUS:%{http_code}")

# Extract HTTP status and body
login_status=$(echo "$login_response" | tail -n1 | sed 's/HTTP_STATUS://')
login_body=$(echo "$login_response" | sed '$d')

if [ "$login_status" = "200" ]; then
    JWT_TOKEN=$(extract_token "$login_body")
    if [ -n "$JWT_TOKEN" ]; then
        print_success "Login successful! Got JWT token"
    else
        print_error "Login response missing token"
        exit 1
    fi
else
    print_error "Login failed with status: $login_status"
    echo "Response: $login_body"
    exit 1
fi

# Step 2: Test the OptiSigns API token first
print_status "Step 2: Testing OptiSigns API token..."

test_response=$(curl -s -X POST \
    "$API_BASE_URL/api/optisigns/config/test" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $JWT_TOKEN" \
    -d "{\"apiToken\":\"$OPTISIGNS_API_TOKEN\"}" \
    -w "\nHTTP_STATUS:%{http_code}")

test_status=$(echo "$test_response" | tail -n1 | sed 's/HTTP_STATUS://')
test_body=$(echo "$test_response" | sed '$d')

if [ "$test_status" = "200" ]; then
    print_success "OptiSigns API token is valid!"
    echo "Response: $test_body"
else
    print_error "OptiSigns API token test failed with status: $test_status"
    echo "Response: $test_body"
    echo ""
    echo "⚠️  Proceeding anyway - the token might still work for some operations"
fi

# Step 3: Save the configuration
print_status "Step 3: Saving OptiSigns configuration..."

config_response=$(curl -s -X PUT \
    "$API_BASE_URL/api/optisigns/config" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $JWT_TOKEN" \
    -d "{\"apiToken\":\"$OPTISIGNS_API_TOKEN\",\"settings\":{\"autoSync\":true,\"syncInterval\":300}}" \
    -w "\nHTTP_STATUS:%{http_code}")

config_status=$(echo "$config_response" | tail -n1 | sed 's/HTTP_STATUS://')
config_body=$(echo "$config_response" | sed '$d')

if [ "$config_status" = "200" ]; then
    print_success "OptiSigns configuration saved successfully!"
    echo "Response: $config_body"
else
    print_error "Configuration save failed with status: $config_status"
    echo "Response: $config_body"
    exit 1
fi

# Step 4: Verify the configuration
print_status "Step 4: Verifying saved configuration..."

verify_response=$(curl -s -X GET \
    "$API_BASE_URL/api/optisigns/config" \
    -H "Authorization: Bearer $JWT_TOKEN" \
    -w "\nHTTP_STATUS:%{http_code}")

verify_status=$(echo "$verify_response" | tail -n1 | sed 's/HTTP_STATUS://')
verify_body=$(echo "$verify_response" | sed '$d')

if [ "$verify_status" = "200" ]; then
    print_success "Configuration verified!"
    echo "Saved config: $verify_body"
else
    print_error "Configuration verification failed"
fi

# Step 5: Test sync functionality
print_status "Step 5: Testing display sync with your API token..."

sync_response=$(curl -s -X POST \
    "$API_BASE_URL/api/optisigns/displays/sync" \
    -H "Authorization: Bearer $JWT_TOKEN" \
    -w "\nHTTP_STATUS:%{http_code}")

sync_status=$(echo "$sync_response" | tail -n1 | sed 's/HTTP_STATUS://')
sync_body=$(echo "$sync_response" | sed '$d')

if [ "$sync_status" = "200" ]; then
    print_success "Display sync working! Your OptiSigns integration is ready!"
    echo "Sync result: $sync_body"
else
    print_error "Display sync failed with status: $sync_status"
    echo "Response: $sync_body"
fi

echo ""
echo "=============================================================="
echo "📊 CONFIGURATION SUMMARY"
echo "=============================================================="
echo "✅ Authentication: Working"
echo "🔧 API Token Test: $( [ "$test_status" = "200" ] && echo "✅ Valid" || echo "⚠️  Issues detected" )"
echo "💾 Configuration Save: $( [ "$config_status" = "200" ] && echo "✅ Successful" || echo "❌ Failed" )"
echo "🔍 Configuration Verify: $( [ "$verify_status" = "200" ] && echo "✅ Confirmed" || echo "❌ Failed" )"
echo "📺 Display Sync: $( [ "$sync_status" = "200" ] && echo "✅ Working" || echo "❌ Failed" )"
echo "=============================================================="

if [ "$config_status" = "200" ]; then
    print_success "🎉 OptiSigns API token successfully configured!"
    echo ""
    echo "🚀 You can now:"
    echo "   • Sync displays: POST /api/optisigns/displays/sync"
    echo "   • Sync assets: POST /api/optisigns/assets/sync"
    echo "   • Pair devices: POST /api/optisigns/devices/pair"
    echo "   • View analytics: GET /api/optisigns/analytics"
    echo ""
    echo "💡 Run the enhanced test script to see all features in action!"
else
    print_error "❌ Configuration failed. Please check your API token and try again."
fi

# Cleanup
unset JWT_TOKEN
unset OPTISIGNS_API_TOKEN


#!/bin/bash

# OptiSigns Schema Validation Test Script
# Tests the corrected GraphQL schema

# Configuration
API_BASE_URL="http://34.122.156.88:3001"  # Replace with your actual server URL
USERNAME="admin"                       
PASSWORD="admin123"                    

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

# Function to make API calls
make_api_call() {
    local method="$1"
    local endpoint="$2"
    local data="$3"
    local auth_header="$4"
    
    if [ -n "$data" ]; then
        response=$(curl -s -X "$method" \
            "$API_BASE_URL$endpoint" \
            -H "Content-Type: application/json" \
            ${auth_header:+-H "Authorization: Bearer $auth_header"} \
            -d "$data" \
            -w "\nHTTP_STATUS:%{http_code}")
    else
        response=$(curl -s -X "$method" \
            "$API_BASE_URL$endpoint" \
            ${auth_header:+-H "Authorization: Bearer $auth_header"} \
            -w "\nHTTP_STATUS:%{http_code}")
    fi
    
    http_status=$(echo "$response" | tail -n1 | sed 's/HTTP_STATUS://')
    response_body=$(echo "$response" | sed '$d')
    
    echo "HTTP Status: $http_status"
    if [ "$http_status" != "200" ]; then
        echo "Error Response: $response_body"
    else
        echo "Success: Operation completed"
    fi
    echo "---"
    
    echo "$http_status|$response_body"
}

extract_token() {
    local response="$1"
    echo "$response" | grep -o '"token":"[^"]*"' | cut -d'"' -f4
}

echo "=============================================================="
echo "🔧 OptiSigns Schema Validation Test"
echo "🎯 Testing corrected GraphQL field names"
echo "=============================================================="

# Step 1: Login
print_status "Step 1: Authenticating..."
login_data="{\"username\":\"$USERNAME\",\"password\":\"$PASSWORD\"}"
login_result=$(make_api_call "POST" "/api/login" "$login_data" "")
login_status=$(echo "$login_result" | cut -d'|' -f1)
login_response=$(echo "$login_result" | cut -d'|' -f2-)

if [ "$login_status" = "200" ]; then
    JWT_TOKEN=$(extract_token "$login_response")
    print_success "Login successful"
else
    print_error "Login failed"
    exit 1
fi

# Step 2: Test configuration
print_status "Step 2: Testing configuration..."
config_result=$(make_api_call "GET" "/api/optisigns/config" "" "$JWT_TOKEN")
config_status=$(echo "$config_result" | cut -d'|' -f1)

if [ "$config_status" = "200" ]; then
    print_success "Configuration endpoint working"
else
    print_error "Configuration endpoint failed"
fi

# Step 3: Test API connection with dummy token (should fail gracefully)
