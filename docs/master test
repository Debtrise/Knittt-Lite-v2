# Step 5: Test display list (should work even with empty data)
print_status "Step 5: Testing display list..."
displays_result=$(make_api_call "GET" "/api/optisigns/displays" "" "$JWT_TOKEN")
displays_status=$(echo "$displays_result" | cut -d'|' -f1)

if [ "$displays_status" = "200" ]; then
    print_success "Display list endpoint working"
else
    print_error "Display list endpoint failed"
fi

# Step 6: Test assets sync
print_status "Step 6: Testing assets sync..."
assets_sync_result=$(make_api_call "POST" "/api/optisigns/assets/sync" "" "$JWT_TOKEN")
assets_sync_status=$(echo "$assets_sync_result" | cut -d'|' -f1)

if [ "$assets_sync_status" = "400" ]; then
    print_success "Assets sync properly requires OptiSigns configuration"
elif [ "$assets_sync_status" = "200" ]; then
    print_success "Assets sync worked!"
else
    print_warning "Assets sync status: $assets_sync_status"
