Custom Report Builder
4. Create Custom Report
Create a new custom report with drag-and-drop widgets.
Endpoint: POST /report-builders
Request Body:
json{
  "name": "Sales Dashboard",
  "description": "Monthly sales performance tracking",
  "layout": {
    "type": "grid",
    "columns": 12,
    "rows": "auto",
    "gap": 16,
    "responsive": true
  },
  "theme": {
    "primaryColor": "#3B82F6",
    "backgroundColor": "#FFFFFF",
    "textColor": "#1F2937"
  },
  "dataSources": [
    {
      "id": "ds1",
      "type": "table",
      "table": "Leads",
      "fields": ["id", "source", "status", "createdAt"],
      "filters": {
        "status": {
          "operator": "in",
          "value": ["qualified", "converted"]
        }
      }
    }
  ],
  "widgets": [
    {
      "type": "metric",
      "title": "Total Leads",
      "position": { "x": 0, "y": 0, "w": 3, "h": 2 },
      "dataSource": {
        "sourceId": "ds1",
        "aggregation": "count",
        "groupBy": []
      },
      "config": {
        "format": "number",
        "prefix": "",
        "suffix": " leads"
      }
    },
    {
      "type": "chart",
      "title": "Leads by Source",
      "position": { "x": 3, "y": 0, "w": 6, "h": 4 },
      "dataSource": {
        "sourceId": "ds1",
        "aggregation": "count",
        "groupBy": ["source"]
      },
      "config": {
        "type": "bar",
        "xAxis": "source",
        "yAxis": "count"
      }
    }
  ],
  "refreshInterval": 300,  // 5 minutes
  "isPublic": false,
  "tags": ["sales", "monthly"]
}
Response:
json{
  "id": 123,
  "name": "Sales Dashboard",
  "publicToken": null,
  "widgets": [...],
  "createdAt": "2024-01-15T10:00:00Z"
}
5. Execute Custom Report
Run a custom report and get the data.
Endpoint: POST /report-builders/{reportId}/execute
Request Body:
json{
  "startDate": "2024-01-01",
  "endDate": "2024-01-31",
  "filters": {
    "source": "Google Ads"
  }
}
Response:
json{
  "id": 456,
  "reportBuilderId": 123,
  "status": "completed",
  "results": {
    "report": {
      "id": 123,
      "name": "Sales Dashboard",
      "layout": {...},
      "theme": {...}
    },
    "widgets": [
      {
        "widgetId": 1,
        "type": "metric",
        "title": "Total Leads",
        "position": {...},
        "data": {
          "value": 180,
          "data": { "count": 180 }
        }
      },
      {
        "widgetId": 2,
        "type": "chart",
        "title": "Leads by Source",
        "data": {
          "labels": ["Google Ads", "Facebook", "Direct"],
          "datasets": [{
            "label": "Leads",
            "data": [180, 120, 150]
          }]
        }
      }
    ],
    "executedAt": "2024-01-15T10:30:00Z"
  },
  "executionTime": 245
}
6. Add Widget to Report
Add a new widget to an existing report.
Endpoint: POST /report-builders/{reportId}/widgets
Request Body:
json{
  "type": "table",
  "title": "Lead Details",
  "position": { "x": 0, "y": 4, "w": 12, "h": 6 },
  "dataSource": {
    "sourceId": "ds1",
    "limit": 50,
    "orderBy": [
      { "field": "createdAt", "direction": "DESC" }
    ]
  },
  "config": {
    "columns": [
      { "field": "id", "label": "ID", "width": 80 },
      { "field": "firstName", "label": "First Name" },
      { "field": "lastName", "label": "Last Name" },
      { "field": "source", "label": "Source" },
      { "field": "status", "label": "Status" }
    ],
    "pageSize": 10,
    "sortable": true
  }
}
